<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set Password"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <!-- Tutorial Text -->
        <TextView
            android:id="@+id/zzzzj_tutorial_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#B3FFFFFF"
            android:textAlignment="center"
            android:layout_marginBottom="24dp"
            android:lineSpacingMultiplier="1.2"
            android:text="Tutorial text here"/>

        <!-- Password Display -->
        <TextView
            android:id="@+id/zzzzj_password_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:background="#1E1E1E"
            android:padding="20dp"
            android:gravity="center"
            android:minHeight="72dp"
            android:letterSpacing="0.2"
            android:fontFamily="monospace"
            android:elevation="4dp"
            android:text=""/>

        <!-- Container for input method (keypad or morse) -->
        <FrameLayout
            android:id="@+id/zzzzj_input_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="300dp"
            android:layout_marginBottom="16dp"/>

        <!-- Status Text -->
        <TextView
            android:id="@+id/zzzzj_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textSize="14sp"
            android:textColor="#FF9800"
            android:gravity="center"
            android:visibility="gone"
            android:text=""/>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/zzzzj_clear_button"
                style="@android:style/Widget.Material.Button.Borderless"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Clear"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp"
                android:minHeight="48dp"/>

            <Button
                android:id="@+id/zzzzj_done_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Done"
                android:textColor="#FFFFFF"
                android:background="#4CAF50"
                android:enabled="false"
                android:minHeight="48dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
