<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Top button bar -->
    <LinearLayout
        android:id="@+id/zzzzd_button_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center">

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/zzzzd_btn_store"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="⬇️"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:background="#333333" />

        <Button
            android:id="@+id/zzzzd_btn_transfer"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="🔗"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:background="#333333" />

        <Button
            android:id="@+id/zzzze_btn_new_folder"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="📁"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:background="#333333" />

        <Button
            android:id="@+id/zzzzh_btn_random"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="🎲"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:background="#333333" />

        <Button
            android:id="@+id/zzzzd_btn_search"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="🔍"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:background="#333333" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>

    <!-- Search bar (hidden by default) -->
    <LinearLayout
        android:id="@+id/zzzzd_search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0.2"/>

        <EditText
            android:id="@+id/zzzzd_search_input"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:hint="Search watch faces..."
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:background="#333333"
            android:padding="8dp"
            android:textSize="14sp"
            android:singleLine="true" />

        <Button
            android:id="@+id/zzzzd_btn_close_search"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="8dp"
            android:text="X"
            android:textColor="#FFFFFF"
            android:background="#333333" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0.2"/>
    </LinearLayout>

    <!-- Watch face grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/zzzzd_watch_face_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="4dp"
        android:scrollbars="vertical" />

</LinearLayout>
