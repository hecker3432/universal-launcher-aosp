<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/zzzzl_qs_root_round"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/x_qs_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_margin="20dp"
        android:background="#000000"
        android:orientation="vertical">

        <TextView
            android:id="@+id/qs_battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="69%"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="23sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/qs_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_toRightOf="@id/qs_battery"
                android:layout_weight="5"
                android:maxLines="1"
                android:text="02/25"
                android:textAlignment="viewEnd"
                android:textColor="#FFFFFF"
                android:textSize="23sp" />

            <Space
                android:layout_width="10dp"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/qs_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="20sp"
                android:layout_toLeftOf="@id/qs_battery"
                android:layout_weight="5"
                android:maxLines="1"
                android:text="12:34"
                android:textColor="#FFFFFF"
                android:textSize="23sp" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        </LinearLayout>

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:shrinkColumns="0"
            android:stretchColumns="1">

            <TableRow>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/qs_volume_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:layout_weight="5"
                    android:background="@drawable/layout_bg"
                    android:clickable="true"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/qs_volume_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autoSizeTextType="uniform"
                        android:maxLines="1"
                        android:text="50%"
                        android:textAlignment="viewEnd"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end|center_vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:autoSizeTextType="uniform"
                            android:maxLines="1"
                            android:text="Volume"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp" />
                        <ImageView
                            android:id="@+id/zzzzk_volume_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/zzzzk_ic_volume"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/qs_data_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:layout_weight="5"
                    android:background="@drawable/layout_bg"
                    android:clickable="true"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/qs_data_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autoSizeTextType="uniform"
                        android:maxLines="1"
                        android:text="off"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/zzzzk_data_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/zzzzk_ic_signal_cellular_4"
                            android:layout_marginEnd="4dp"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:autoSizeTextType="uniform"
                            android:maxLines="1"
                            android:text="Data"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp" />
                        <TextView
                            android:id="@+id/zzzzk_data_freq"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="11sp"
                            android:textColor="#AAAAAA"
                            android:maxLines="1"/>
                    </LinearLayout>
                </LinearLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </TableRow>

            <TableRow>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="@drawable/brightness_low_white" />

                <SeekBar
                    android:id="@+id/qs_brightness_slider"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1000"
                    android:max="255"
                    android:minHeight="20dp"
                    android:progressDrawable="@drawable/zzzzl_thick_brightness_slider"
                    android:thumb="@drawable/zzzzl_thick_brightness_slider_thumb" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="@drawable/brightness_high_white" />
            </TableRow>

            <TableRow>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="0.5" />

                <LinearLayout
                    android:id="@+id/qs_bt_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:layout_weight="5"
                    android:background="@drawable/layout_bg"
                    android:clickable="true"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end|center_vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:autoSizeTextType="uniform"
                            android:maxLines="1"
                            android:text="Bluetooth"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp" />
                        <ImageView
                            android:id="@+id/zzzzk_bt_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/zzzzk_ic_bluetooth"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/qs_bt_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autoSizeTextType="uniform"
                        android:maxLines="1"
                        android:text="off"
                        android:textAlignment="viewEnd"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/qs_wifi_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:layout_weight="5"
                    android:background="@drawable/layout_bg"
                    android:clickable="true"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/zzzzk_wifi_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/zzzzk_ic_wifi_signal_4"
                            android:layout_marginEnd="4dp"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:autoSizeTextType="uniform"
                            android:maxLines="1"
                            android:text="WiFi"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp" />
                        <TextView
                            android:id="@+id/zzzzk_wifi_freq"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="11sp"
                            android:textColor="#AAAAAA"
                            android:maxLines="1"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/qs_wifi_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autoSizeTextType="uniform"
                        android:maxLines="1"
                        android:text="off"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />
                </LinearLayout>


                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="0.5" />
            </TableRow>

            <TableRow
                android:id="@+id/qs_extra_row"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/qs_airplane_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:layout_weight="5"
                    android:background="@drawable/layout_bg"
                    android:clickable="true"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/zzzzk_airplane_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/zzzzk_ic_airplane"
                            android:layout_marginEnd="4dp"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autoSizeTextType="uniform"
                            android:maxLines="1"
                            android:text="Airplane"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/qs_airplane_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autoSizeTextType="uniform"
                        android:maxLines="1"
                        android:text="off"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/qs_hotspot_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:layout_weight="5"
                    android:background="@drawable/layout_bg"
                    android:clickable="true"
                    android:orientation="vertical"
                    android:padding="15dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/zzzzk_hotspot_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/zzzzk_ic_hotspot"
                            android:layout_marginEnd="4dp"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autoSizeTextType="uniform"
                            android:maxLines="1"
                            android:text="Hotspot"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/qs_hotspot_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autoSizeTextType="uniform"
                        android:maxLines="1"
                        android:text="off"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp" />
                </LinearLayout>
            </TableRow>
        </TableLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="5dp"
            android:orientation="horizontal">

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="70" />

            <LinearLayout
                android:id="@+id/x_qs_launcherSetting"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/layout_bg"
                android:orientation="vertical"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/qs_launcher_setting"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/edit" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="30" />

            <LinearLayout
                android:id="@+id/x_qs_flashlight"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/layout_bg"
                android:orientation="vertical"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/qs_flashlight"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/flashlight" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="30" />

            <LinearLayout
                android:id="@+id/x_qs_settings"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/layout_bg"
                android:orientation="vertical"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/qs_settings"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/settings" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="70" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="70" />

            <LinearLayout
                android:id="@+id/x_qs_recents"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/layout_bg"
                android:orientation="vertical"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/qs_recents"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/recents" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="20" />

            <LinearLayout
                android:id="@+id/x_qs_power"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/layout_bg"
                android:orientation="vertical"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/qs_power"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/power" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="70" />
        </LinearLayout>


    </LinearLayout>
</RelativeLayout>