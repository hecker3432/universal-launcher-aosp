<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:descendantFocusability="blocksDescendants" android:layout_width="fill_parent" android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/clock_gallery_preview"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true" />
    <TextView
        android:textSize="22.0dip"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:gravity="center_horizontal"
        android:layout_centerHorizontal="true"
        android:id="@id/folder_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="13.0dip"
        android:layout_centerInParent="true"
        android:textAlignment="center"
        android:layout_margin="20dp"/>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="50dip"
        android:layout_below="@id/folder_name"
        android:layout_centerHorizontal="true">
        <Button
            android:id="@+id/xxx_pin_clock"
            android:layout_width="wrap_content"
            android:layout_height="40.0dip"
            android:text="pin"
            android:textColor="#FFFFFF"
            android:background="#cca806"/>
        <Space
            android:layout_width="10dp"
            android:layout_height="0dp"/>
        <Button
            android:id="@id/delete_clock"
            android:layout_width="wrap_content"
            android:layout_height="40.0dip"
            android:text="delete"
            android:textColor="#FFFFFF"
            android:background="#FF0000"/>
    </LinearLayout>
</RelativeLayout>
