<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/linearLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:padding="12dp"
    android:orientation="vertical"
    android:maxWidth="400dp"
    android:minWidth="280dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="100">
        <Button
            android:id="@+id/zzzzg_scaleMinusBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="15"
            android:text="-"
            android:textSize="25sp"
            android:textStyle="bold"
            android:minWidth="0dp"
            android:minHeight="0dp"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="70"
            android:text="Scale: 10%"
            android:textAlignment="center"
            android:textSize="25sp"
            android:id="@id/scaleText"/>
        <Button
            android:id="@+id/zzzzg_scalePlusBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="15"
            android:text="+"
            android:textSize="25sp"
            android:textStyle="bold"
            android:minWidth="0dp"
            android:minHeight="0dp"/>
    </LinearLayout>
    <SeekBar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:max="100"
        android:progress="50"
        android:id="@id/scaleBar"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:text="fit vertical ↕️"
        android:textAlignment="center"
        android:textSize="20sp"
        android:id="@+id/modeText"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="50">
        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="10"
            android:maxWidth="46dp"
            android:maxHeight="46dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/crop"
            android:id="@+id/modeCrop"/>
        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="10"
            android:maxWidth="46dp"
            android:maxHeight="46dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/x_crop_comp"
            android:id="@+id/zzzzc_modeCropCompat"/>
        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="10"
            android:maxWidth="46dp"
            android:maxHeight="46dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/stretch"
            android:id="@+id/modeStretch"/>
        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="10"
            android:maxWidth="46dp"
            android:maxHeight="46dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/scale"
            android:id="@+id/modeScale"/>
        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="10"
            android:maxWidth="46dp"
            android:maxHeight="46dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/x_scale_comp"
            android:id="@+id/zzzzc_modeScaleCompat"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="30">
        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="10"
            android:maxWidth="40dp"
            android:maxHeight="40dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/night_on"
            android:id="@+id/night"/>
        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="10"
            android:maxWidth="40dp"
            android:maxHeight="40dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/step_on"
            android:id="@+id/step"/>
        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="10"
            android:maxWidth="40dp"
            android:maxHeight="40dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/heart_on"
            android:id="@id/heart"/>
    </LinearLayout>

</LinearLayout>
