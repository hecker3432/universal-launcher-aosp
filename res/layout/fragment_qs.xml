<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:id="@+id/x_qs_bg">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:id="@+id/qs_status_bar">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/qs_battery"
            android:text="69%"
            android:textSize="22sp"
            android:layout_centerInParent="true"
            android:textColor="#FFFFFF"
            android:maxLines="1"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/qs_time"
            android:text="12:34"
            android:textSize="22sp"
            android:layout_toLeftOf="@id/qs_battery"
            android:layout_marginRight="20sp"
            android:textColor="#FFFFFF"
            android:maxLines="1"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/qs_date"
            android:text="02/25"
            android:textSize="22sp"
            android:layout_toRightOf="@id/qs_battery"
            android:layout_marginLeft="20dp"
            android:textColor="#FFFFFF"
            android:maxLines="1"/>
    </RelativeLayout>

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:shrinkColumns="0"
        android:stretchColumns="1">
        <TableRow>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="5"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/qs_wifi_button"
                android:layout_margin="10dp"
                android:padding="15dp"
                android:background="@drawable/layout_bg"
                android:clickable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/zzzzk_wifi_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/zzzzk_ic_wifi_signal_4"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="WiFi"
                        android:textSize="22sp"
                        android:textColor="#FFFFFF"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"/>
                    <TextView
                        android:id="@+id/zzzzk_wifi_freq"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="#AAAAAA"
                        android:maxLines="1"/>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="off"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    android:id="@+id/qs_wifi_detail"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="5"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/qs_data_button"
                android:layout_margin="10dp"
                android:padding="15dp"
                android:background="@drawable/layout_bg"
                android:clickable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/zzzzk_data_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/zzzzk_ic_signal_cellular_4"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Data"
                        android:textSize="22sp"
                        android:textColor="#FFFFFF"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"/>
                    <TextView
                        android:id="@+id/zzzzk_data_freq"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="#AAAAAA"
                        android:maxLines="1"/>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="off"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    android:id="@+id/qs_data_detail"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"/>
            </LinearLayout>
        </TableRow>
        <TableRow>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="5"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/qs_bt_button"
                android:layout_margin="10dp"
                android:padding="15dp"
                android:background="@drawable/layout_bg"
                android:clickable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/zzzzk_bt_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/zzzzk_ic_bluetooth"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bluetooth"
                        android:textSize="22sp"
                        android:textColor="#FFFFFF"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"/>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="off"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    android:id="@+id/qs_bt_detail"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="5"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/qs_volume_button"
                android:layout_margin="10dp"
                android:padding="15dp"
                android:background="@drawable/layout_bg"
                android:clickable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/zzzzk_volume_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/zzzzk_ic_volume"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Volume"
                        android:textSize="22sp"
                        android:textColor="#FFFFFF"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"/>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="50%"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    android:id="@+id/qs_volume_detail"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"/>
            </LinearLayout>
        </TableRow>
        <TableRow
            android:visibility="gone"
            android:id="@+id/qs_extra_row">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="5"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/qs_airplane_button"
                android:layout_margin="10dp"
                android:padding="15dp"
                android:background="@drawable/layout_bg"
                android:clickable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/zzzzk_airplane_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/zzzzk_ic_airplane"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Airplane"
                        android:textSize="22sp"
                        android:textColor="#FFFFFF"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"/>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="off"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    android:id="@+id/qs_airplane_detail"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="5"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/qs_hotspot_button"
                android:layout_margin="10dp"
                android:padding="15dp"
                android:background="@drawable/layout_bg"
                android:clickable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/zzzzk_hotspot_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/zzzzk_ic_hotspot"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Hotspot"
                        android:textSize="22sp"
                        android:textColor="#FFFFFF"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"/>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="off"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    android:id="@+id/qs_hotspot_detail"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"/>
            </LinearLayout>
        </TableRow>
    </TableLayout>




    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="10dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/brightness_low_white"/>
        <SeekBar
            android:layout_width="wrap_content"
            android:layout_weight="1000"
            android:layout_height="wrap_content"
            android:minHeight="20dp"
            android:max="255"
            android:id="@+id/qs_brightness_slider"
            android:progressDrawable="@drawable/zzzzl_thick_brightness_slider"
            android:thumb="@drawable/zzzzl_thick_brightness_slider_thumb" />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/brightness_high_white" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginVertical="5dp">
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="70"/>
        <LinearLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:orientation="vertical"
            android:background="@drawable/layout_bg"
            android:padding="10dp"
            android:id="@+id/x_qs_launcherSetting">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/edit"
                android:id="@+id/qs_launcher_setting"/>
        </LinearLayout>
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="10"/>
        <LinearLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:orientation="vertical"
            android:background="@drawable/layout_bg"
            android:padding="10dp"
            android:id="@+id/x_qs_recents">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/recents"
                android:id="@+id/qs_recents"/>
        </LinearLayout>
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="10"/>
        <LinearLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:orientation="vertical"
            android:background="@drawable/layout_bg"
            android:padding="10dp"
            android:id="@+id/x_qs_flashlight">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/flashlight"
                android:id="@+id/qs_flashlight"/>
        </LinearLayout>
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="10"/>
        <LinearLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:orientation="vertical"
            android:background="@drawable/layout_bg"
            android:padding="10dp"
            android:id="@+id/x_qs_power">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/power"
                android:id="@+id/qs_power"/>
        </LinearLayout>
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="10"/>
        <LinearLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:orientation="vertical"
            android:background="@drawable/layout_bg"
            android:padding="10dp"
            android:id="@+id/x_qs_settings">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/settings"
                android:id="@+id/qs_settings"/>
        </LinearLayout>
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="70"/>
    </LinearLayout>



</LinearLayout>